{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=firewatch_gateway;Username=postgres;Password=ana123"
  },
  "Jwt": {
    "Secret": "firewatch-super-secret-key-minimo-32-caracteres!!",
    "Issuer": "firewatch-gateway",
    "Audience": "firewatch-clients",
    "ExpiresInMinutes": "60",
    "RefreshExpiresInDays": "7"
  },
  "ReverseProxy": {
    "Routes": {
      "ingestion-route": {
        "ClusterId": "ingestion-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/ingestion/{**catch-all}" }
      },
      "risk-route": {
        "ClusterId": "risk-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/risk/{**catch-all}" }
      }
    },
    "Clusters": {
      "ingestion-cluster": {
        "Destinations": {
          "ingestion-svc": { "Address": "http://localhost:5000" }
        }
      },
    "risk-cluster": {
      "Destinations": {
        "risk-svc": { "Address": "http://localhost:5001" }
      }
    }
  }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}